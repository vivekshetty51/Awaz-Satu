LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Permitted caller telephone number for IVR testing (e.g. your configured Twilio number)
ALLOWED_CALLER_NUMBER=""

# --- Multilingual Speech Recognition (ASR) ---
# Set ASR_PROVIDER to 'groq' to use hosted high-speed Whisper on LPUs, or 'local' for local CPU Whisper
ASR_PROVIDER=local
# Optional Groq API Key (Free tier from console.groq.com)
GROQ_API_KEY=""
GROQ_ASR_MODEL=whisper-large-v3-turbo

# --- Conversational AI (LLM) ---
# Set LLM_PROVIDER to 'gemini' for multi-lingual conversational responses, or 'offline' for local fallback
LLM_PROVIDER=gemini
# Google Gemini API Key (Free tier from Google AI Studio)
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-flash-latest


# --- RAG over official Karnataka government sources ---
# Build the index once with: python -m app.rag.ingest
RAG_ENABLED=true
# Best-match similarity needed before answering from official sources (tune with: python -m app.rag.ask "question")
RAG_THRESHOLD=0.60
# Optional: comma-separated extra domains allowed for crawling (default: karnataka.gov.in,kar.nic.in)
# RAG_ALLOWED_DOMAINS=karnataka.gov.in,kar.nic.in

# --- Language ---
# English only for now. Set ENGLISH_ONLY=false when regional languages are added.
ENGLISH_ONLY=true
VOICE_LANGUAGE=en
# faster-whisper model (English-only checkpoints are the most accurate for English): tiny.en | base.en | small.en
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8

# --- RAG embedding (free-tier quotas are small: few texts per request, pause between) ---
# RAG_EMBED_BATCH=20
# RAG_EMBED_PAUSE=12
# RAG_MAX_PAGES=25
# RAG_CRAWL_DEPTH=2

# --- Gemini reliability (503 "high demand" and daily quotas are common on the free tier) ---
# Each Gemini model has its own free-tier counters. RAG tries these in order after GEMINI_MODEL:
# RAG_FALLBACK_MODELS=gemini-flash-lite-latest
# RAG_GEN_TIMEOUT=12
